{
  "name": "sikuliVS",
  "displayName": "sikuliVS",
  "description": "sikuliVS adds the sikuliX specific features of the sikuliX IDE into VScode",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sikuliVS.region",
        "title": "SikuliVS: Create Region",
        "icon": "$(screen-full)"
      },
      {
        "command": "sikuliVS.capture",
        "title": "SikuliVS: Capture Image",
        "icon": "$(device-camera)"
      },
      {
        "command": "sikuliVS.offset",
        "title": "SikuliVS: Set Target Offset",
        "icon": "$(target)"
      },
      {
        "command": "sikuliVS.match",
        "title": "SikuliVS: Preview Matches",
        "icon": "$(eye)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sikuliVS-sidebar",
          "title": "SikuliVS",
          "icon": "media/sikuliVS.svg"
        }
      ]
    },
    "views": {
      "sikuliVS-sidebar": [
        {
          "id": "sikuliVS.regionView",
          "name": "SikuliX Tools"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.121.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {}
}