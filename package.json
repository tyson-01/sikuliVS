{
  "name": "sikulivs",
  "displayName": "sikuliVS",
  "description": "sikuliVS adds the sikuliX specific features of the sikuliX IDE into VScode",
  "version": "0.1.0",
  "publisher": "tyson-01",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onDebugResolve:sikulivs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sikuliVS.runScript",
        "title": "SikuliVS: Run Script",
        "icon": "$(play)"
      },
      {
        "command": "sikuliVS.stopScript",
        "title": "SikuliVS: Stop Script",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sikuliVS.debugScript",
        "title": "SikuliVS: Debug Script",
        "icon": "$(debug-alt)"
      },
      {
        "command": "sikuliVS.region",
        "title": "SikuliVS: Create Region",
        "icon": "$(screen-full)"
      },
      {
        "command": "sikuliVS.location",
        "title": "SikuliVS: Pick Location",
        "icon": "$(location)"
      },
      {
        "command": "sikuliVS.showLocation",
        "title": "SikuliVS: Show Location",
        "icon": "$(search)"
      },
      {
        "command": "sikuliVS.capture",
        "title": "SikuliVS: Capture Image",
        "icon": "$(device-camera)"
      },
      {
        "command": "sikuliVS.offset",
        "title": "SikuliVS: Set Target Offset",
        "icon": "$(target)"
      },
      {
        "command": "sikuliVS.match",
        "title": "SikuliVS: Preview Matches",
        "icon": "$(eye)"
      },
      {
        "command": "sikuliVS.highlight",
        "title": "SikuliVS: Highlight Region",
        "icon": "$(sparkle)"
      },
      {
        "command": "sikuliVS.console",
        "title": "SikuliVS: Interactive Console",
        "icon": "$(terminal)"
      },
      {
        "command": "sikuliVS.debugHighlight",
        "title": "SikuliVS: Highlight on Screen",
        "icon": "$(sparkle)"
      },
      {
        "command": "sikuliVS.debugCopyRegion",
        "title": "SikuliVS: Copy as Region(...)",
        "icon": "$(clippy)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "sikuliVS.runScript",
          "when": "resourceLangId == python && !sikuliVS.running",
          "group": "navigation@1"
        },
        {
          "command": "sikuliVS.debugScript",
          "when": "resourceLangId == python && !sikuliVS.running",
          "group": "navigation@2"
        },
        {
          "command": "sikuliVS.stopScript",
          "when": "resourceLangId == python && sikuliVS.running",
          "group": "navigation@1"
        }
      ],
      "debug/variables/context": [
        {
          "command": "sikuliVS.debugHighlight",
          "when": "debugConfigurationType == 'sikulivs'",
          "group": "sikulivs@1"
        },
        {
          "command": "sikuliVS.debugCopyRegion",
          "when": "debugConfigurationType == 'sikulivs'",
          "group": "sikulivs@2"
        }
      ],
      "commandPalette": [
        {
          "command": "sikuliVS.debugHighlight",
          "when": "false"
        },
        {
          "command": "sikuliVS.debugCopyRegion",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sikuliVS-sidebar",
          "title": "SikuliVS",
          "icon": "media/sikuliVS.svg"
        }
      ]
    },
    "views": {
      "sikuliVS-sidebar": [
        {
          "id": "sikuliVS.regionView",
          "name": "SikuliX Tools"
        }
      ]
    },
    "configuration": {
      "title": "SikuliVS",
      "properties": {
        "sikuliVS.jarPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to `sikulixapi-<version>.jar`. When empty, a `sikulix*.jar` found in a workspace root is used."
        },
        "sikuliVS.javaPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Java runtime used to launch SikuliX. When empty, `$JAVA_HOME/bin/java` is tried, then `java` on PATH. Must be a headful JRE; a headless one cannot access the screen."
        },
        "sikuliVS.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python interpreter for the visual tools (region, location, capture, offset, match). When empty, a `.venv` beside the extension is tried, then one in a workspace root, then `python3` on `PATH`; the first that can import `cv2`, `numpy`, `PIL`, `tkinter` and `dbus_fast` is used. An extension installed from a .vsix has no bundled virtualenv, so this usually needs setting."
        },
        "sikuliVS.debugLevel": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 3,
          "description": "SikuliX -d debug level. 0 omits the option entirely; 3 logs everything, including where startup fails."
        },
        "sikuliVS.jvmArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra JVM arguments, e.g. `--enable-native-access=ALL-UNNAMED` to silence Java 24+ native access warnings. Never added automatically, since older JVMs reject unknown flags."
        },
        "sikuliVS.debug.captureMode": {
          "type": "string",
          "enum": [
            "actions",
            "stops",
            "off"
          ],
          "enumDescriptions": [
            "Photograph the screen after every line that did something, and at every stop. Makes the filmstrip a recording of the run.",
            "Photograph the screen only when the script stops at a breakpoint, exception or pause.",
            "Never capture. Removes the small pause each capture adds."
          ],
          "default": "actions",
          "markdownDescription": "When a debugged script has its screen photographed for the SikuliVS Debug panel. Captures are taken before the editor is told about a stop, so they show the script's screen rather than the editor, and are written to a temp folder that is cleared when the next run starts."
        }
      }
    },
    "breakpoints": [
      {
        "language": "python"
      }
    ],
    "debuggers": [
      {
        "type": "sikulivs",
        "label": "SikuliX Script",
        "languages": [
          "python"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The Jython script to debug. A script inside a .sikuli bundle resolves its images against that bundle.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Break on the first line of the script.",
                "default": false
              },
              "bundle": {
                "type": "string",
                "description": "Folder images resolve against. Defaults to the script's own folder.",
                "default": ""
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sikulivs",
            "request": "launch",
            "name": "SikuliX: Debug Script",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "SikuliVS: Debug the open script",
            "description": "Runs the open Jython script under SikuliX with breakpoints enabled.",
            "body": {
              "type": "sikulivs",
              "request": "launch",
              "name": "SikuliX: Debug Script",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test:unit": "npm run compile && node --test out/test/*.spec.js",
    "test:python": "./.venv/bin/python3 -m unittest discover -s python_gui/tests"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {},
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tyson-01/sikuliVS.git"
  },
  "keywords": [
    "sikuli",
    "sikulix",
    "automation",
    "gui-testing",
    "jython",
    "image-recognition"
  ]
}
